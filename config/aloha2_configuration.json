{
  "variant": {
    "id": "aloha2",
    "name": "ALOHA 2 (bimanual follower robot)",
    "rationale": "aloha-2.github.io links (a) the ALOHA 2 hardware repo (CAD/STL only, no URDF), (b) the official MuJoCo model (mujoco_menagerie/aloha, MJCF, two follower ViperX-300 arms) and (c) the Trossen Robotics ALOHA kits as the commercial ALOHA 2 hardware. The only public ALOHA 2 URDF is the Trossen/Interbotix aloha_vx300s / aloha_wx250s description; its arm kinematics were cross-verified against the official MJCF (config/aloha2_crosscheck.json). Original ALOHA (tonyzhaozh/aloha v1) specifications are not used. Kyoto University's exact hardware is unconfirmed.",
    "sources": {
      "site": "https://aloha-2.github.io/",
      "descriptions": "Interbotix/interbotix_ros_manipulators@b66d5b9 (humble) interbotix_xsarm_descriptions",
      "mjcf": "google-deepmind/mujoco_menagerie@62ab00f aloha/aloha.xml",
      "constants": "Interbotix/aloha@4fa6b2c aloha/constants.py",
      "spec_follower": "https://docs.trossenrobotics.com/interbotix_xsarms_docs/specifications/avx300s.html",
      "spec_leader": "https://docs.trossenrobotics.com/interbotix_xsarms_docs/specifications/awx250s.html"
    }
  },
  "complete_robot_definition": "ALOHA 2 robot = two follower ALOHA ViperX-300 6DOF arms with every URDF link and joint (incl. gripper prop, fingers and finger mimic) mounted at the official ALOHA 2 MJCF base poses. Leader WidowX-250 arms are generated and validated as standalone models. Not modelled (no public machine-readable geometry for the URDF format): aluminium frame, table, cameras, passive gravity compensation.",
  "mount_source": "google-deepmind/mujoco_menagerie@62ab00f aloha/aloha.xml (left/base_link, right/base_link body poses)",
