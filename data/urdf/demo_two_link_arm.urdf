<?xml version="1.0"?>
<!-- Teaching robot for live demos of the HT GEN7 PhysAI Studio. Not a real product: all values are defined
     in tools/make_demo_robot.py (uniform boxes, I = m/12 (b^2 + c^2)). Regenerate, do not hand-edit. -->
<robot name="demo_two_link_arm">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <mass value="2"/>
      <inertia ixx="0.00773333" ixy="0" ixz="0" iyy="0.00773333" iyz="0" izz="0.00213333"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
      <geometry><box size="0.08 0.08 0.2"/></geometry>
      <material name="base_link_colour"><color rgba="0.35 0.38 0.42 1"/></material>
    </visual>
  </link>
  <link name="upper_arm">
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00016" ixy="0" ixz="0" iyy="0.00458" iyz="0" izz="0.00458"/>
    </inertial>
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry><box size="0.3 0.04 0.04"/></geometry>
      <material name="upper_arm_colour"><color rgba="0.15 0.39 0.92 1"/></material>
    </visual>
  </link>
  <link name="forearm">
    <inertial>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <mass value="0.35"/>
      <inertia ixx="5.25e-05" ixy="0" ixz="0" iyy="0.00184917" iyz="0" izz="0.00184917"/>
    </inertial>
    <visual>
      <origin xyz="0.125 0 0" rpy="0 0 0"/>
      <geometry><box size="0.25 0.03 0.03"/></geometry>
      <material name="forearm_colour"><color rgba="0.92 0.35 0.05 1"/></material>
    </visual>
  </link>
  <joint name="shoulder" type="revolute">
    <parent link="base_link"/>
    <child link="upper_arm"/>
    <origin xyz="0 0 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="6" velocity="3.14"/>
  </joint>
  <joint name="elbow" type="revolute">
    <parent link="upper_arm"/>
    <child link="forearm"/>
    <origin xyz="0.3 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="3" velocity="3.14"/>
  </joint>
</robot>
