within ;
package ALOHA2 "ALOHA 2 robot generated from public engineering sources (URDF, kinematic / prescribed-motion)"
  extends Modelica.Icons.Package;
  annotation (
    uses(Modelica(version = "4.1.0")),
    version = "1.1.0",
    Documentation(info="<html>
<h4>ALOHA 2 virtual twin</h4>
<p>Generated by the K&amp;KH Engineering Studio generator v1.1.0 from pinned public sources:</p>
<ul><li>Interbotix/interbotix_ros_manipulators@b66d5b9 (humble) interbotix_xsarm_descriptions (URDF/xacro, meshes)</li><li>google-deepmind/mujoco_menagerie@62ab00f aloha/aloha.xml (base poses only)</li>
<li>Interbotix/aloha@4fa6b2c aloha/constants.py (start pose, gripper constants)</li></ul>
<p>Robot: 29 links (incl. world), 28 joints, 16 driven joints,
2 mimic joints. One <code>Components.RigidLink</code> per URDF link and one joint component per URDF joint.
Masses and inertias are URDF values; URDF placeholder inertials are massless.</p>
<p>Run <code>ALOHA2.Experiments.RightArmReach</code>. Meshes: Interbotix, BSD-3-Clause (Resources/Licenses).</p></html>"));
end ALOHA2;
