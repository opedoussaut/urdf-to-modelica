<?xml version="1.0"?>
<!-- Synthetic test robot: non-zero joint-origin rpy on every joint, mixed axes, a prismatic joint,
     a fixed joint with rotation and a mimic joint. Exercises URDF conventions the ALOHA URDF does not. -->
<robot name="rpy_chain">
  <link name="base">
    <inertial><origin xyz="0 0 0.05" rpy="0 0 0"/><mass value="1.0"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/></inertial>
  </link>
  <joint name="j1" type="revolute">
    <origin xyz="0.1 0.0 0.2" rpy="0.3 -0.2 0.7"/><parent link="base"/><child link="l1"/>
    <axis xyz="0 0 1"/><limit lower="-3" upper="3" effort="10" velocity="3"/>
  </joint>
  <link name="l1">
    <inertial><origin xyz="0.1 0 0" rpy="0.1 0.2 0.3"/><mass value="0.5"/>
      <inertia ixx="0.002" ixy="0.0001" ixz="0" iyy="0.003" iyz="0" izz="0.004"/></inertial>
  </link>
  <joint name="j2" type="revolute">
    <origin xyz="0.25 0.05 -0.03" rpy="-1.2 0.4 0.1"/><parent link="l1"/><child link="l2"/>
    <axis xyz="0 1 0"/><limit lower="-2" upper="2" effort="10" velocity="3"/>
  </joint>
  <link name="l2">
    <inertial><origin xyz="0.05 0 0" rpy="0 0 0"/><mass value="0.3"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial>
  </link>
  <joint name="slide" type="prismatic">
    <origin xyz="0.2 0 0" rpy="0.5 0.5 0.5"/><parent link="l2"/><child link="l3"/>
    <axis xyz="1 0 0"/><limit lower="0" upper="0.1" effort="20" velocity="0.5"/>
  </joint>
  <link name="l3">
    <inertial><origin xyz="0 0 0" rpy="0 0 0"/><mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="tool_mount" type="fixed">
    <origin xyz="0.03 0.02 0.01" rpy="1.5707963 0 -0.6"/><parent link="l3"/><child link="tool"/>
  </joint>
  <link name="tool"/>
  <joint name="twin" type="revolute">
    <origin xyz="0 0.04 0" rpy="0 0.9 0"/><parent link="l2"/><child link="l4"/>
    <axis xyz="1 0 0"/><limit lower="-2" upper="2" effort="5" velocity="3"/>
    <mimic joint="j2" multiplier="-0.5" offset="0.1"/>
  </joint>
  <link name="l4">
    <inertial><origin xyz="0.02 0 0" rpy="0 0 0"/><mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
  </link>
</robot>
